{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint -- *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test -- *)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:tooling)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e -- *)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run db:status)",
      "Bash(npm run db:types)",
      "Bash(npm run db:types:check)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint *)",
      "Bash(npx prettier --check *)",
      "Bash(npx prettier --write *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(npm run gate*)",
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr ready*)",
      "Bash(gh stack*)",
      "Bash(gh issue comment*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr status*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(graphify query *)",
      "Bash(graphify path *)",
      "Bash(graphify explain *)",
      "Bash(graphify update *)",
      "Bash(python3 -B .agents/skills/issue-logger/scripts/gh_issue.py next*)",
      "Bash(python3 -B .agents/skills/issue-logger/scripts/gh_related_issues.py*)",
      "mcp__stitch__get_screen",
      "mcp__stitch__list_screens"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(gh pr close*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(python3 -B .agents/skills/issue-logger/scripts/gh_parent_issue.py*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(npm run db:reset*)",
      "Bash(npm run db:provision-member*)",
      "Bash(supabase db reset*)",
      "Bash(vercel*)",
      "mcp__stitch__generate_screen_from_text",
      "mcp__stitch__edit_screens"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./supabase/.env)",
      "Read(**/*.pem)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./supabase/.env)",
      "Bash(cat .env*)",
      "Bash(supabase db push*)",
      "Bash(npx supabase db push*)"
    ]
  },
  "enabledMcpjsonServers": ["stitch", "vercel"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-git.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|create_file|replace_string_in_file|multi_replace_string_in_file|insert_edit_into_file|edit_notebook_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-files.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|create_file|replace_string_in_file|multi_replace_string_in_file|insert_edit_into_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/graphify-update.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
