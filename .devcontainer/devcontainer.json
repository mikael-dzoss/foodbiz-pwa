{
  "name": "foodbiz-pwa",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": true,
      "toolsToInstall": "graphifyy"
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Next.js", "onAutoForward": "notify" }
  },
  "containerEnv": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "remoteEnv": {
    "STITCH_API_KEY": "${localEnv:STITCH_API_KEY}"
  },
  "mounts": [
    "source=foodbiz-pwa-gemini-data,target=/home/node/.gemini,type=volume",
    "source=foodbiz-pwa-antigravity-server,target=/home/node/.antigravity-ide-server,type=volume",
    "source=foodbiz-pwa-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/stitch-mcp.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "vitest.explorer",
        "supabase.vscode-supabase-extension",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        "eamodio.gitlens",
        "redhat.vscode-yaml",
        "google.google-antigravity"
      ]
    }
  }
}
