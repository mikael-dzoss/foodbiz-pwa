# Supabase CLI local Google OAuth credentials
# To enable local Google OAuth with the Supabase CLI, copy this file to supabase/.env and fill in credentials:
#   cp supabase/.env.example supabase/.env
#
# Google Cloud Console redirect URI for local CLI:
#   http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
