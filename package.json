{
  "name": "foodbiz-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "DATA_SOURCE=${DATA_SOURCE:-supabase} next build",
    "build:local": "node scripts/build-local.mjs",
    "start": "next start",
    "lint": "eslint && node scripts/check-tailwind-classes.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/test-results.json",
    "test:tooling": "vitest run --config vitest.tooling.config.mts && npm run -s test:tooling:py",
    "test:tooling:py": "python3 -B -m trace --count --summary --missing --coverdir=coverage/tooling-py --ignore-dir=\"$(python3 -c \"import os,site,sysconfig as s;print(os.pathsep.join([s.get_paths()['stdlib'],s.get_paths()['purelib'],site.getusersitepackages()]))\")\" --module unittest discover -s .agents/skills/issue-logger/scripts",
    "test:live": "vitest run src/lib/repositories/tests/supabase-live.contract.test.ts src/lib/supabase/tests/storage-live.contract.test.ts src/lib/supabase/tests/realtime-live.contract.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "node scripts/gate.mjs",
    "gate:quick": "node scripts/gate.mjs --quick",
    "gate:full": "node scripts/gate.mjs --full",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:supabase": "node scripts/e2e-supabase.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:test": "supabase test db",
    "db:types": "node scripts/db-types.mjs",
    "db:types:check": "node scripts/db-types.mjs --check",
    "db:seed:gen": "vitest run src/lib/repositories/tests/seed-sql.test.ts -u",
    "db:provision-member": "node scripts/provision-member.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
