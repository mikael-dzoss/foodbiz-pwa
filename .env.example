# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# NEXT_PUBLIC_* values are exposed to the browser: never put secrets here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Canonical site origin for auth redirects and metadata (optional in dev, required in production)
# e.g. http://localhost:3000 locally, https://your-domain.com in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data backend: mock (in-memory fixtures for dev/test) | supabase
DATA_SOURCE=mock

# Server-only comma-separated list of manager emails permitted to sign in during development and test.
# Honoured only when app environment is development or test; unconditionally ignored in production.
ALLOWED_MANAGER_EMAILS=manager@lapetiteboulangerie.fr,dev@lapetiteboulangerie.fr
