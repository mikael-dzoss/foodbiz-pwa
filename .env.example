# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# NEXT_PUBLIC_* values are exposed to the browser: never put secrets here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Canonical site origin for auth redirects and metadata (optional in dev and on Vercel previews;
# required in production and on the staging branch override)
# e.g. http://localhost:3000 locally, https://foodbiz-pwa-git-staging-<team-slug>.vercel.app on staging
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data backend: mock (in-memory fixtures for dev/test) | supabase
DATA_SOURCE=mock

# E2E_TEST_HOOKS=1 enables POST /api/test/reset (mock data only, never in production). It is set by
# playwright.config.ts for the e2e dev server; leave it unset everywhere else.

# Business served by the public storefront (server-only UUID, businesses.id). Required when DATA_SOURCE=supabase;
# in mock mode it defaults to the mock demo business. The local seed (supabase/seed.sql) uses the id below.
STOREFRONT_BUSINESS_ID=11111111-1111-4111-8111-111111111111

# Application environment: development | test | staging | production.
# Optional; unset falls back to NODE_ENV. Use APP_ENV=staging on hosted staging and Vercel previews.
# Dev/test allow-list and auto-provisioning are honoured only when both NODE_ENV and APP_ENV resolve to development or test.
APP_ENV=development

# Server-only comma-separated list of manager emails permitted to sign in during development and test.
# Honoured only when app environment is development or test; unconditionally ignored in production or staging.
# In dev/test with Supabase mode, allow-listed Google users without a membership are auto-provisioned to the demo business.
ALLOWED_MANAGER_EMAILS=dev@example.com

# Optional demo business slug for local dev/test auto-provisioning (defaults to la-petite-boulangerie, matching supabase/seed.sql).
DEV_BUSINESS_SLUG=la-petite-boulangerie

# Supabase Service Role Key (server-only secret: NEVER expose to the browser, NEVER prefix with NEXT_PUBLIC_).
# Used for server CLI member provisioning (npm run db:provision-member) and in development/test for local manager auto-provisioning.
# Throws if invoked outside development or test environments during app runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel system variables (set by Vercel, leave unset locally).
# Used on Vercel preview deployments (VERCEL_ENV=preview) to resolve the OAuth callback origin without trusting forwarded headers.
# VERCEL_URL and VERCEL_BRANCH_URL are hostnames without protocol (e.g. foodbiz-pwa-git-staging-team.vercel.app).
# VERCEL_ENV=preview
# VERCEL_URL=
# VERCEL_BRANCH_URL=
