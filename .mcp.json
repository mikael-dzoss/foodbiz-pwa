{
  "mcpServers": {
    "stitch": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/stitch-mcp-bridge.mjs"],
      "env": {
        "STITCH_API_KEY": "${STITCH_API_KEY}",
        "STITCH_TIMEOUT_MS": "180000"
      }
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com",
      "headers": {
        "Authorization": "Bearer ${VERCEL_API_TOKEN}"
      }
    }
  }
}
